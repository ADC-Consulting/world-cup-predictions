generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              String               @id @default(cuid())
  name            String
  username        String               @unique
  passwordHash    String
  isAdmin         Boolean              @default(false)
  createdAt       DateTime             @default(now())
  predictions     Prediction[]
  championPick    ChampionPick?
  topScorerPicks  TopScorerPick[]
  resetTokens     PasswordResetToken[]
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id])
}

model TopScorerPick {
  id         String @id @default(cuid())
  userId     String
  slot       Int
  playerName String
  position   String // "DEFENDER" | "MIDFIELDER" | "FORWARD"
  user       User   @relation(fields: [userId], references: [id])

  @@unique([userId, slot])
}

model ScorerGoalEntry {
  id         String @id @default(cuid())
  playerName String @unique
  goals      Int    @default(0)
}

model AppSetting {
  key   String @id
  value String
}

model Team {
  id              String         @id @default(cuid())
  name            String         @unique
  group           String
  flag            String
  homeMatches     Match[]        @relation("HomeTeam")
  awayMatches     Match[]        @relation("AwayTeam")
  penaltyWins     Match[]        @relation("PenaltyWinner")
  championPicks   ChampionPick[]
}

model Match {
  id                String         @id @default(cuid())
  homeTeamId        String
  awayTeamId        String
  group             String
  stage             String         @default("group")
  scheduledAt       DateTime
  homeScore         Int?
  awayScore         Int?
  penaltyWinnerId   String?
  homeTeam          Team           @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam          Team           @relation("AwayTeam", fields: [awayTeamId], references: [id])
  penaltyWinner     Team?          @relation("PenaltyWinner", fields: [penaltyWinnerId], references: [id])
  predictions       Prediction[]
}

model Prediction {
  id              String   @id @default(cuid())
  userId          String
  matchId         String
  homeScore       Int
  awayScore       Int
  submittedAt     DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id])
  match           Match    @relation(fields: [matchId], references: [id])

  @@unique([userId, matchId])
}

model ChampionPick {
  id      String @id @default(cuid())
  userId  String @unique
  teamId  String
  user    User   @relation(fields: [userId], references: [id])
  team    Team   @relation(fields: [teamId], references: [id])
}
